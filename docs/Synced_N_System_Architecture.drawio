        <mxCell id="card_ui_member" value="&lt;div style=&quot;font-size: 11px; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #4F46E5;&quot;&gt;Member Experience Hub&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;MemberActivity.kt&lt;/code&gt; (Compose)&lt;br/&gt;• Duty Schedule &amp;amp; Rehearsals&lt;br/&gt;• Unavailable Range Date Picker&lt;br/&gt;• Substitution Request Handshake&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;strokeWidth=1.5;arcSize=6;align=left;valign=top;spacing=8;" parent="zone_app" vertex="1">
