        <mxCell id="card_ui_tools" value="&lt;div style=&quot;font-size: 11px; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #059669;&quot;&gt;Musician Rehearsal Suite&lt;/b&gt; (Interactive Features)&lt;br/&gt;• &lt;code&gt;ChordSheetInput.kt&lt;/code&gt; (ChordPro Format &amp;amp; In-Line Chord Rendering)&lt;br/&gt;• Real-Time Key Transposition Engine (Root &amp;amp; Semitone Shifting)&lt;br/&gt;• &lt;code&gt;MetronomeView.kt&lt;/code&gt; (Visual &amp;amp; Audio BPM Pulse, Tap-to-Tempo)&lt;br/&gt;• &lt;code&gt;SheetAutoScrollControls.kt&lt;/code&gt; (Smooth Hands-Free Scrolling)&lt;br/&gt;• Worship Video Player (Embedded YouTube ID Parser)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;arcSize=6;align=left;valign=top;spacing=8;" parent="zone_app" vertex="1">
          <mxGeometry x="325" y="300" width="350" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="card_ui_collab" value="&lt;div style=&quot;font-size: 11px; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #D97706;&quot;&gt;Team Collaboration &amp;amp; Alerts&lt;/b&gt;&lt;br/&gt;• Real-Time Team Channel Chat (Text &amp;amp; Photo Attachments)&lt;br/&gt;• Ministry Announcements with High-Priority Urgent Banner&lt;br/&gt;• User Profile &amp;amp; Avatar Customization (Camera &amp;amp; Gallery)&lt;br/&gt;• Session Sign-Out &amp;amp; Cache Wipe&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;arcSize=6;align=left;valign=top;spacing=8;" parent="zone_app" vertex="1">
          <mxGeometry x="685" y="300" width="350" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="sub_state" value="&lt;div style=&quot;text-align: center; font-size: 11.5px; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #4338CA;&quot;&gt;Reactive State Management &amp;amp; Coroutine Lifecycles&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #475569;&quot;&gt;Compose State Holders (&lt;code&gt;remember&lt;/code&gt;, &lt;code&gt;mutableStateOf&lt;/code&gt;) • Asynchronous Coroutines (&lt;code&gt;Dispatchers.IO&lt;/code&gt; / &lt;code&gt;Main&lt;/code&gt;) • Real-Time Firestore Snapshots&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#6366F1;strokeWidth=1.5;arcSize=6;" parent="zone_app" vertex="1">
          <mxGeometry x="310" y="425" width="740" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="sub_repo" value="Repository &amp;amp; Business Logic Layer (Data Synchronization Hub)" style="swimlane;startSize=28;rounded=1;arcSize=4;fillColor=#EEF2FF;strokeColor=#818CF8;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#3730A3;align=left;spacingLeft=10;collapsible=0;" parent="zone_app" vertex="1">
          <mxGeometry x="310" y="490" width="740" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="card_repo_hub" value="&lt;div style=&quot;font-size: 11px; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #4F46E5;&quot;&gt;Repositories &amp;amp; Core Managers&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;TeamRepository.kt&lt;/code&gt; (Centralized Singleton Data Hub)&lt;br/&gt;• &lt;code&gt;FirestoreManager.kt&lt;/code&gt; (Cloud Firestore CRUD Gateway)&lt;br/&gt;• &lt;code&gt;AuthManager.kt&lt;/code&gt; (Firebase Auth Session Coordinator)&lt;br/&gt;• &lt;code&gt;SessionManager.kt&lt;/code&gt; (Local Credential &amp;amp; Token Storage)&lt;br/&gt;• In-Flight Throttling (15s Request Cooldown &amp;amp; Anti-Loop Guards)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;strokeWidth=1.5;arcSize=6;align=left;valign=top;spacing=8;" parent="zone_app" vertex="1">
          <mxGeometry x="325" y="530" width="350" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="card_repo_engine" value="&lt;div style=&quot;font-size: 11px; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;Client-Side Validation &amp;amp; Conflict Engines&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;ValidationUtils.kt&lt;/code&gt; (Strict Form &amp;amp; Team Code Validators)&lt;br/&gt;• Schedule Overlap Detector (Prevents Double-Booking on Dates)&lt;br/&gt;• Availability Range Checker (&lt;code&gt;UnavailableRange.includes()&lt;/code&gt;)&lt;br/&gt;• Substitution Status State Machine (Pending/Accepted/Declined)&lt;br/&gt;• Multi-Tenant Code Generator (&lt;code&gt;generateTeamCode()&lt;/code&gt;)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F87171;strokeWidth=1.5;arcSize=6;align=left;valign=top;spacing=8;" parent="zone_app" vertex="1">
          <mxGeometry x="685" y="530" width="350" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="card_repo_clients" value="&lt;div style=&quot;font-size: 11px; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #0284C7;&quot;&gt;External Service Clients &amp;amp; Network Gateways&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;CloudinaryUploader.kt&lt;/code&gt; (Direct HTTPS Multipart Upload for Avatars &amp;amp; Chat Images)&lt;br/&gt;• &lt;code&gt;ImageLoader.kt&lt;/code&gt; (Bitmap In-Memory Decryption &amp;amp; Asynchronous Canvas Renderer)&lt;br/&gt;• &lt;code&gt;EmailOtpService.kt&lt;/code&gt; (Brevo REST API Client for Transactional OTP Password Resets)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#38BDF8;strokeWidth=1.5;arcSize=6;align=left;valign=top;spacing=8;" parent="zone_app" vertex="1">
          <mxGeometry x="325" y="650" width="710" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="card_models" value="&lt;div style=&quot;font-size: 11px; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #475569;&quot;&gt;Kotlin Domain Data Models&lt;/b&gt; (Immutable Data Classes with &lt;code&gt;toMap()&lt;/code&gt; / &lt;code&gt;fromMap()&lt;/code&gt; Serialization):&lt;br/&gt;&lt;code&gt;UserProfile&lt;/code&gt; • &lt;code&gt;TeamData&lt;/code&gt; • &lt;code&gt;TeamMember&lt;/code&gt; • &lt;code&gt;ServiceData&lt;/code&gt; • &lt;code&gt;ServiceAssignment&lt;/code&gt; • &lt;code&gt;RehearsalData&lt;/code&gt; • &lt;code&gt;ServiceSong&lt;/code&gt; • &lt;code&gt;SongData&lt;/code&gt; • &lt;code&gt;SubstitutionData&lt;/code&gt; • &lt;code&gt;AnnouncementData&lt;/code&gt; • &lt;code&gt;ChatMessage&lt;/code&gt; • &lt;code&gt;UnavailableRange&lt;/code&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;arcSize=6;align=left;valign=top;spacing=8;" parent="zone_app" vertex="1">
          <mxGeometry x="325" y="735" width="710" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="sub_cache" value="Local Caching &amp;amp; Offline Persistence Tier" style="swimlane;startSize=26;rounded=1;arcSize=4;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontStyle=1;fontSize=11.5;fontColor=#1E293B;align=left;spacingLeft=10;collapsible=0;" parent="zone_app" vertex="1">
          <mxGeometry x="310" y="825" width="740" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="card_cache_mem" value="&lt;div style=&quot;font-size: 11px; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #0D9488;&quot;&gt;In-Memory Concurrent Cache&lt;/b&gt; (60 FPS Performance)&lt;br/&gt;• &lt;code&gt;ConcurrentHashMap&amp;lt;String, MutableList&amp;gt;&lt;/code&gt;&lt;br/&gt;• Caches: Rosters, Services, Songs, Announcements, Substitutions, &amp;amp; Chat&lt;br/&gt;• Prevents UI Jank, Flickering, and Excessive Firebase Billing Reads&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14B8A6;strokeWidth=1.5;arcSize=6;align=left;valign=top;spacing=8;" parent="zone_app" vertex="1">
          <mxGeometry x="325" y="860" width="350" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="card_cache_prefs" value="&lt;div style=&quot;font-size: 11px; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #6366F1;&quot;&gt;Android SharedPreferences Storage&lt;/b&gt; (Offline Resilience)&lt;br/&gt;• &lt;code&gt;team_services_&amp;lt;code&amp;gt;&lt;/code&gt; &amp;amp; &lt;code&gt;cached_roster_&amp;lt;code&amp;gt;&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;cached_messages_&amp;lt;code&amp;gt;&lt;/code&gt; &amp;amp; &lt;code&gt;synced_user_profile&lt;/code&gt;&lt;br/&gt;• Automatic Fallback: Loads Cached Data Instantly When Network is Offline&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#818CF8;strokeWidth=1.5;arcSize=6;align=left;valign=top;spacing=8;" parent="zone_app" vertex="1">
          <mxGeometry x="685" y="860" width="350" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="zone_backend" value="3. BACKEND &amp;amp; CLOUD SERVICES TIER" style="swimlane;startSize=40;rounded=1;arcSize=4;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontStyle=1;fontSize=14;fontColor=#14532D;align=center;collapsible=0;" parent="1" vertex="1">
          <mxGeometry x="1100" y="105" width="580" height="990" as="geometry"/>
        </mxCell>
        <mxCell id="sub_firebase" value="Google Firebase Cloud Platform (Official Backend)" style="swimlane;startSize=28;rounded=1;arcSize=4;fillColor=#DCFCE7;strokeColor=#22C55E;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#15803D;align=left;spacingLeft=10;collapsible=0;" parent="zone_backend" vertex="1">
          <mxGeometry x="1120" y="155" width="540" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="card_fb_auth" value="&lt;div style=&quot;font-size: 11px; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #15803D; font-size: 12px;&quot;&gt;Firebase Authentication&lt;/b&gt;&lt;br/&gt;• Secure Email &amp;amp; Password Identity Management&lt;br/&gt;• Encrypted Password Hashing (BCrypt/Scrypt on Google Cloud)&lt;br/&gt;• Cryptographic Auth Tokens &amp;amp; UID Generation&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1.5;arcSize=6;align=left;valign=top;spacing=8;" parent="zone_backend" vertex="1">
          <mxGeometry x="1135" y="195" width="510" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="card_fb_firestore" value="&lt;div style=&quot;font-size: 11px; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #15803D; font-size: 12px;&quot;&gt;Cloud Firestore (NoSQL Real-Time Document Database)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color: #475569; font-weight: bold;&quot;&gt;Multi-Tenant Hierarchical Subcollection Architecture:&lt;/span&gt;&lt;br/&gt;&lt;div style=&quot;background-color: #F8FAFC; border: 1px solid #E2E8F0; padding: 6px; border-radius: 4px; font-family: monospace; font-size: 10.5px; margin-top: 4px; line-height: 1.4;&quot;&gt;• /users/{uid} ➔ (Profiles, Ministry Roles, Unavailable Dates)&lt;br/&gt;• /teams/{teamCode} ➔ (6-Char Code, Leader UID, Custom Roles)&lt;br/&gt;&amp;nbsp;&amp;nbsp;↳ /services/{serviceId} ➔ (Title, Date, Duties, Lineup, Rehearsal)&lt;br/&gt;&amp;nbsp;&amp;nbsp;↳ /songs/{songId} ➔ (ChordPro Sheets, BPM, Key, YouTube URL)&lt;br/&gt;&amp;nbsp;&amp;nbsp;↳ /announcements/{id} ➔ (Headline, Body, Urgent Priority Flag)&lt;br/&gt;&amp;nbsp;&amp;nbsp;↳ /substitutions/{id} ➔ (Requester, Substitute, Reason, Status)&lt;br/&gt;&amp;nbsp;&amp;nbsp;↳ /messages/{messageId} ➔ (Sender, Role, Text, Cloudinary Media)&lt;br/&gt;• /password_resets/{email} ➔ (OTP Handshake &amp;amp; Hash)&lt;/div&gt;&lt;span style=&quot;font-size: 10px; color: #047857; font-weight: 500;&quot;&gt;Secured by Granular Declarative Security Rules (&lt;code&gt;firestore.rules&lt;/code&gt;)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1.5;arcSize=6;align=left;valign=top;spacing=8;" parent="zone_backend" vertex="1">
          <mxGeometry x="1135" y="285" width="510" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="card_fb_fcm" value="&lt;div style=&quot;font-size: 11px; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #15803D; font-size: 12px;&quot;&gt;Firebase Cloud Messaging (FCM)&lt;/b&gt;&lt;br/&gt;• Automatic Push Notification Triggers for Service Assignments&lt;br/&gt;• Real-Time Alerts for High-Priority / Urgent Ministry Announcements&lt;br/&gt;• Immediate Notice on Lineup Modifications &amp;amp; Substitution Handshakes&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1.5;arcSize=6;align=left;valign=top;spacing=8;" parent="zone_backend" vertex="1">
          <mxGeometry x="1135" y="575" width="510" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="sub_ext" value="Third-Party External Cloud Infrastructure (HTTPS / REST)" style="swimlane;startSize=28;rounded=1;arcSize=4;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontStyle=1;fontSize=12;fontColor=#1E40AF;align=left;spacingLeft=10;collapsible=0;" parent="zone_backend" vertex="1">
          <mxGeometry x="1120" y="690" width="540" height="285" as="geometry"/>
        </mxCell>
        <mxCell id="card_ext_cloudinary" value="&lt;div style=&quot;font-size: 11px; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #2563EB; font-size: 12px;&quot;&gt;Cloudinary Media Cloud CDN&lt;/b&gt;&lt;br/&gt;• High-Availability Cloud Storage for Member Profile Avatars&lt;br/&gt;• Real-Time Compression &amp;amp; CDN Hosting for Team Chat Photo Attachments&lt;br/&gt;• Direct HTTPS Multipart Upload via &lt;code&gt;CloudinaryUploader.kt&lt;/code&gt;&lt;br/&gt;• Secure Delivery via Worldwide Content Delivery Network (CDN)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;arcSize=6;align=left;valign=top;spacing=8;" parent="zone_backend" vertex="1">
          <mxGeometry x="1135" y="730" width="510" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="card_ext_brevo" value="&lt;div style=&quot;font-size: 11px; color: #1E293B;&quot;&gt;&lt;b style=&quot;color: #2563EB; font-size: 12px;&quot;&gt;Brevo (Sendinblue) Transactional Email API&lt;/b&gt;&lt;br/&gt;• Transactional Email Gateway for User Account Recovery&lt;br/&gt;• Automated 6-Digit OTP Delivery to Member's Registered Email Address&lt;br/&gt;• HTTPS REST API Dispatch via &lt;code&gt;EmailOtpService.kt&lt;/code&gt;&lt;br/&gt;• Strict 10-Minute OTP Expiry &amp;amp; Single-Use Invalidation&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;arcSize=6;align=left;valign=top;spacing=8;" parent="zone_backend" vertex="1">
