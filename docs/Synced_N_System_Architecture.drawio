        <mxCell id="actor_leader" value="&lt;div style=&quot;text-align: center; padding: 4px;&quot;&gt;&lt;div style=&quot;background-color: #3B82F6; color: #FFFFFF; font-weight: bold; border-radius: 4px; padding: 4px 6px; font-size: 13px; margin-bottom: 8px;&quot;&gt;Ministry Leader / Admin&lt;/div&gt;&lt;div style=&quot;text-align: left; font-size: 11px; color: #334155; line-height: 1.5;&quot;&gt;• Creates &amp;amp; Configures Team (6-char Code)&lt;br/&gt;• Manages Member Roster &amp;amp; Ministry Roles&lt;br/&gt;• Plans Worship Services &amp;amp; Rehearsals&lt;br/&gt;• Assigns Stage Duties &amp;amp; Detects Conflicts&lt;br/&gt;• Curates Song Catalog &amp;amp; ChordPro Sheets&lt;br/&gt;• Evaluates Substitution Requests&lt;br/&gt;• Broadcasts Urgent Team Announcements&lt;br/&gt;• Participates in Team Group Chat&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;shadow=1;arcSize=6;align=left;valign=top;spacingTop=8;" parent="zone_users" vertex="1">
          <mxGeometry x="55" y="170" width="200" height="390" as="geometry"/>
        </mxCell>
        <mxCell id="actor_member" value="&lt;div style=&quot;text-align: center; padding: 4px;&quot;&gt;&lt;div style=&quot;background-color: #10B981; color: #FFFFFF; font-weight: bold; border-radius: 4px; padding: 4px 6px; font-size: 13px; margin-bottom: 8px;&quot;&gt;Music Ministry Member&lt;/div&gt;&lt;div style=&quot;text-align: left; font-size: 11px; color: #334155; line-height: 1.5;&quot;&gt;• Vocalists, Musicians &amp;amp; Sound Operators&lt;br/&gt;• Joins Ministry via 6-Char Team Code&lt;br/&gt;• Submits Date-Range Unavailable Times&lt;br/&gt;• Views Assigned Worship Duties &amp;amp; Rehearsals&lt;br/&gt;• Interactive ChordPro Viewer &amp;amp; Transposition&lt;br/&gt;• Metronome Pulse &amp;amp; Sheet Auto-Scroll&lt;br/&gt;• Initiates &amp;amp; Responds to Substitutions&lt;br/&gt;• Team Chat with Photo Attachments&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=2;shadow=1;arcSize=6;align=left;valign=top;spacingTop=8;" parent="zone_users" vertex="1">
          <mxGeometry x="55" y="580" width="200" height="390" as="geometry"/>
