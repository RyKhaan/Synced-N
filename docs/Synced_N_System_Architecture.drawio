        <mxCell id="banner" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;font-size: 24px; color: #0F172A; letter-spacing: 0.5px;&quot;&gt;SYNCED N: SYSTEM ARCHITECTURE DESIGN&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; color: #475569; font-weight: 500;&quot;&gt;Church Music Ministry Schedule &amp;amp; Lineup Management System • Android (Kotlin + Jetpack Compose) &amp;amp; Firebase Cloud Platform&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;arcSize=6;" parent="1" vertex="1">
