        <mxCell id="zone_users" value="1. USERS &amp;amp; ACTORS TIER" style="swimlane;startSize=40;rounded=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontStyle=1;fontSize=14;fontColor=#1E293B;align=center;collapsible=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="105" width="230" height="990" as="geometry"/>
