        <mxCell id="erd_title" value="&lt;b style='font-size:20px;color:#0F172A;'&gt;ENTITY-RELATIONSHIP DIAGRAM (ERD) — SYNCED N CLOUD FIRESTORE DATABASE SCHEMA&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#475569;'&gt;Information Engineering (Crow's Foot) Notation • Root Collections (/users, /teams, /password_resets), Team Subcollections, Embedded Structures &amp;amp; Planned FCM/Notifications&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;align=center;verticalAlign=middle;" parent="1" vertex="1">
