        <mxCell id="ent_USERS_fields" value="&lt;b style='color:#B91C1C;'&gt;[PK]&lt;/b&gt; &lt;b&gt;uid&lt;/b&gt; : &lt;b style='color:#0369A1;'&gt;STRING(128)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Firebase Auth UID (Immutable)&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;username : &lt;b style='color:#0369A1;'&gt;STRING(50)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Display Username (NOT NULL)&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;email : &lt;b style='color:#0369A1;'&gt;STRING(100)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Unique Email Address&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;fullName : &lt;b style='color:#0369A1;'&gt;STRING(100)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Full Name of Member/Leader&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;phone : &lt;b style='color:#0369A1;'&gt;STRING(25)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Philippine Mobile (+639/09)&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;country : &lt;b style='color:#0369A1;'&gt;STRING(50)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Default &amp;#x27;Philippines&amp;#x27;&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;language : &lt;b style='color:#0369A1;'&gt;STRING(50)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Default &amp;#x27;English&amp;#x27;&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;role : &lt;b style='color:#0369A1;'&gt;STRING&lt;/b&gt; &lt;span style='color:#475569;'&gt;— &amp;#x27;Leader&amp;#x27; | &amp;#x27;Member&amp;#x27;&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ministryRole : &lt;b style='color:#0369A1;'&gt;STRING(50)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Assigned Instrument / Vocal Role&lt;/span&gt;&lt;br&gt;&lt;b style='color:#1D4ED8;'&gt;[FK]&lt;/b&gt; teamCode : &lt;b style='color:#0369A1;'&gt;STRING(6)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Nullable -&amp;gt; TEAMS.teamCode&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;teamName : &lt;b style='color:#0369A1;'&gt;STRING(100)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Denormalized Team Name&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;photoUri : &lt;b style='color:#0369A1;'&gt;STRING(500)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Cloudinary HTTPS Avatar URL&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;resetPassword : &lt;b style='color:#0369A1;'&gt;STRING(128)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Verified OTP Reset Password&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;fcmToken : &lt;b style='color:#0369A1;'&gt;STRING(256)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— [Planned FCM] Device Push Token&lt;/span&gt;&lt;br&gt;&lt;b style='color:#7C2D12;'&gt;[EMB]&lt;/b&gt; notificationPreferences : &lt;b style='color:#0369A1;'&gt;MAP&amp;lt;BOOL&amp;gt;&lt;/b&gt; &lt;span style='color:#475569;'&gt;— [Planned] Cloud Settings Sync&lt;/span&gt;&lt;br&gt;&lt;b style='color:#7C2D12;'&gt;[EMB]&lt;/b&gt; unavailableRanges : &lt;b style='color:#0369A1;'&gt;ARRAY&amp;lt;MAP&amp;gt;&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Embedded Blackout Date Ranges&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;createdAt : &lt;b style='color:#0369A1;'&gt;INT64&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Epoch Timestamp (ms)&lt;/span&gt;" style="text;html=1;strokeColor=#1D4ED8;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;whiteSpace=wrap;overflow=hidden;rotatable=0;fontFamily=Arial;fontSize=11;fontColor=#0F172A;" parent="ent_USERS" vertex="1">
