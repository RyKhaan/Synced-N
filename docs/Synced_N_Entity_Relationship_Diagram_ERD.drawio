        <mxCell id="ent_NOTIFICATIONS_fields" value="&lt;b style='color:#B91C1C;'&gt;[PK]&lt;/b&gt; &lt;b&gt;id&lt;/b&gt; : &lt;b style='color:#0369A1;'&gt;STRING&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Notification Document ID&lt;/span&gt;&lt;br&gt;&lt;b style='color:#1D4ED8;'&gt;[FK]&lt;/b&gt; teamCode : &lt;b style='color:#0369A1;'&gt;STRING(6)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— References TEAMS.teamCode&lt;/span&gt;&lt;br&gt;&lt;b style='color:#1D4ED8;'&gt;[FK]&lt;/b&gt; recipientUid : &lt;b style='color:#0369A1;'&gt;STRING(128)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Target USERS.uid (or &amp;#x27;ALL&amp;#x27;)&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;type : &lt;b style='color:#0369A1;'&gt;STRING(30)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— &amp;#x27;SERVICE&amp;#x27;|&amp;#x27;LINEUP&amp;#x27;|&amp;#x27;SUB&amp;#x27;|&amp;#x27;URGENT&amp;#x27;&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;title : &lt;b style='color:#0369A1;'&gt;STRING(120)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Notification Headline&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;message : &lt;b style='color:#0369A1;'&gt;STRING(500)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Notification Body Content&lt;/span&gt;&lt;br&gt;&lt;b style='color:#1D4ED8;'&gt;[FK]&lt;/b&gt; referenceId : &lt;b style='color:#0369A1;'&gt;STRING(128)&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Linked Service/Sub/Announcement ID&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;isRead : &lt;b style='color:#0369A1;'&gt;BOOLEAN&lt;/b&gt; &lt;span style='color:#475569;'&gt;— Read Status Flag&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;fcmDispatched : &lt;b style='color:#0369A1;'&gt;BOOLEAN&lt;/b&gt; 