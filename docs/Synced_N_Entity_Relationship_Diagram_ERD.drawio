 Timestamp (ms)&lt;/span&gt;" style="text;html=1;strokeColor=#047857;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;whiteSpace=wrap;overflow=hidden;rotatable=0;fontFamily=Arial;fontSize=11;fontColor=#0F172A;" parent="ent_CHAT_MESSAGES" vertex="1">
